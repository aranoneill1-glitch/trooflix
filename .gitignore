# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# wrangler (local Cloudflare dev-emulator state — do not commit)
.wrangler

# typescript
*.tsbuildinfo
next-env.d.ts
ios/

# local audit / recon dumps (never commit)
recon_output.txt
morning_output.txt
morning_cleanup.txt
homepage_creators.txt
comments_source.txt
*_output.txt
